  "level": "A1",
  "order": 40,
  "title": "Preposiciones de dativo: aus, bei, mit, nach, seit, von, zu",
  "objectives": [
    "Aprender las siete preposiciones que rigen siempre dativo: aus, bei, mit, nach, seit, von, zu",
    "Aplicar el dativo obligatoriamente después de estas preposiciones, sin excepción",
    "Reconocer las contracciones más frecuentes: zu + dem = zum, zu + der = zur, bei + dem = beim, von + dem = vom"
  ],
  "sections": [
    {
      "type": "explanation",
      "title": "Siete preposiciones que exigen dativo siempre",
      "body": "Hay un grupo de preposiciones alemanas que rigen dativo en el 100% de los casos, sin excepción: aus, bei, mit, nach, seit, von y zu. Si ves una de estas siete palabras, el sustantivo que la sigue va obligatoriamente en dativo.",
      "examples": [
        { "target": "Ich spreche mit dem Mann.", "es": "Hablo con el hombre.", "note": "mit + dativo" },
        { "target": "Ich fahre nach Deutschland.", "es": "Voy a Alemania.", "note": "nach + país, sin artículo" },
        { "target": "Ich bin beim Arzt.", "es": "Estoy en el médico.", "note": "bei + dem = beim" }
      ]
    },
    {
      "type": "table",
      "title": "Las siete preposiciones de dativo",
      "headers": ["Preposición", "Significado", "Ejemplo"],
      "rows": [
        ["aus", "de, desde (origen)", "Ich komme aus Spanien."],
        ["bei", "en casa de, junto a", "Ich bin beim Arzt."],
        ["mit", "con", "Ich spreche mit dem Mann."],
        ["nach", "hacia (destino); después de", "Ich fahre nach Deutschland."],
        ["seit", "desde (tiempo)", "Seit einer Woche bin ich hier."],
        ["von", "de, desde (procedencia, posesión)", "Das ist ein Geschenk vom Lehrer."],
        ["zu", "a, hacia", "Ich fahre zur Schule."]
      ],
      "note": "nach y aus, delante de un país, no llevan artículo: nach Deutschland, aus Spanien."
    },
    {
      "type": "table",
      "title": "Las contracciones más frecuentes",
      "headers": ["Preposición + artículo", "Contracción"],
      "rows": [
        ["zu + dem", "zum"],
        ["zu + der", "zur"],
        ["bei + dem", "beim"],
        ["von + dem", "vom"]
      ],
      "note": "Estas contracciones son casi obligatorias en el habla cotidiana: decir «zu dem» suena forzado."
    },
    {
      "type": "tip",
      "body": "Memoriza las siete preposiciones de dativo en una frase o acrónimo que te resulte fácil: por ejemplo, «Ana Baila Mientras Nada Sucede Verdaderamente Zumbando» (aus, bei, mit, nach, seit, von, zu). Cualquier frase tonta que te ayude a recordarlas en orden vale."
    }
  ],
